<section class="preferences" aria-labelledby="preferences-title">
  <div class="preferences-heading">
    <p class="eyebrow">Preferenze</p>
    <h2 id="preferences-title">Personalizza la lettura del tempo</h2>
  </div>

  <div class="preference-grid">
    <label for="theme-mode">
      Tema
      <select id="theme-mode">
        <option value="auto">Automatico</option>
        <option value="dark">Scuro</option>
        <option value="light">Chiaro</option>
      </select>
    </label>

    <label for="decimal-format">
      Formato decimale
      <select id="decimal-format">
        <option value="digital">Digitale 5:00:00</option>
        <option value="fraction">Frazione 0,50000</option>
      </select>
    </label>

    <label for="decimal-display">
      Orologio decimale
      <select id="decimal-display">
        <option value="both">Digitale + Analogico</option>
        <option value="digital">Solo Digitale</option>
        <option value="analog">Solo Analogico</option>
      </select>
    </label>

    <label for="normal-display">
      Orologio normale
      <select id="normal-display">
        <option value="both">Digitale + Analogico</option>
        <option value="digital">Solo Digitale</option>
        <option value="analog">Solo Analogico</option>
      </select>
    </label>

    <label class="checkbox-control" for="show-tenths">
      <input id="show-tenths" type="checkbox" checked />
      Mostra decimi di secondo
    </label>
  </div>
</section>
