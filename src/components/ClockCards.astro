<section class="clocks" aria-label="Orologi">
  <article class="clock-card normal-card">
    <div class="clock-header">
      <div>
        <p class="clock-label">Ora normale</p>
        <p class="clock-subtitle">24 ore, 60 minuti, 60 secondi</p>
      </div>
    </div>
    <time id="normal-clock" class="clock-value" datetime="00:00:00">00:00:00</time>
    <p id="normal-date" class="clock-note">--</p>
    <p id="timezone-note" class="clock-note subtle-note">Fuso orario: --</p>
  </article>

  <article class="clock-card decimal-card" id="decimal-card">
    <div class="clock-header">
      <div>
        <p class="clock-label">Ora decimale</p>
        <p class="clock-subtitle">10 ore, 100 minuti, 100 secondi</p>
      </div>
    </div>
    <div class="decimal-clock-layout">
      <div class="decimal-digital" id="decimal-digital">
        <time id="decimal-clock" class="clock-value" datetime="0:00:00">0:00:00</time>
      </div>
      <div class="decimal-analog" id="decimal-analog" aria-label="Quadrante analogico decimale">
        <svg viewBox="0 0 200 200" role="img">
          <circle class="analog-ring" cx="100" cy="100" r="86" />
          <circle class="analog-inner" cx="100" cy="100" r="5" />
          <text x="100" y="28">0</text>
          <text x="143" y="42">1</text>
          <text x="170" y="80">2</text>
          <text x="170" y="126">3</text>
          <text x="143" y="164">4</text>
          <text x="100" y="178">5</text>
          <text x="57" y="164">6</text>
          <text x="30" y="126">7</text>
          <text x="30" y="80">8</text>
          <text x="57" y="42">9</text>
          <g id="decimal-hour-hand"><line class="analog-hand hour-hand" x1="100" y1="100" x2="100" y2="58" /></g>
          <g id="decimal-minute-hand"><line class="analog-hand minute-hand" x1="100" y1="100" x2="100" y2="34" /></g>
          <g id="decimal-second-hand"><line class="analog-hand second-hand" x1="100" y1="100" x2="100" y2="24" /></g>
        </svg>
      </div>
    </div>
    <p class="clock-note">Mezzogiorno = 5:00:00, fine giornata = 10:00:00</p>
  </article>
</section>
