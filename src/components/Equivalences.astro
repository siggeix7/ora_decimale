---
const items = [
  ["1 ora decimale", "2h 24m", "Un decimo della giornata classica."],
  ["1 minuto decimale", "86,4s", "Poco piu di un minuto classico."],
  ["1 secondo decimale", "0,864s", "Leggermente piu corto del secondo SI."],
];
---
<section class="equivalences" aria-labelledby="equivalences-title">
  <div class="equivalences-heading">
    <p class="eyebrow">Equivalenze</p>
    <h2 id="equivalences-title">Quanto dura un pezzo di tempo decimale</h2>
  </div>

  <div class="equivalence-grid">
    {items.map(([label, value, note]) => (
      <article>
        <span>{label}</span>
        <strong>{value}</strong>
        <p>{note}</p>
      </article>
    ))}
  </div>
</section>
