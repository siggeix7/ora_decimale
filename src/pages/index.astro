---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import TabNav from "../components/TabNav.astro";
import ClockCards from "../components/ClockCards.astro";
import DayProgress from "../components/DayProgress.astro";
import History from "../components/History.astro";
import Equivalences from "../components/Equivalences.astro";
import Converter from "../components/Converter.astro";
import Details from "../components/Details.astro";
---
<BaseLayout>
  <main class="page">
    <Hero />
    <TabNav />

    <div id="panel-orologio" class="tab-panel active" data-panel="orologio" role="tabpanel" aria-labelledby="tab-orologio">
      <ClockCards />
      <DayProgress />
    </div>

    <div id="panel-storia" class="tab-panel" data-panel="storia" role="tabpanel" aria-labelledby="tab-storia" hidden>
      <History />
    </div>

    <div id="panel-convertitore" class="tab-panel" data-panel="convertitore" role="tabpanel" aria-labelledby="tab-convertitore" hidden>
      <Equivalences />
      <Converter />
      <Details />
    </div>
  </main>
</BaseLayout>
